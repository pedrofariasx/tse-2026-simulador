data/processed/tse_6257_t1.jsonl
# checkpoint do raspador (controla o "retomar"); sem sentido fora da máquina
data/processed/tse_6257_t1.done
# comparecimento por município/zona; regenerado junto com o dump
data/processed/tse_6257_t1_ab.jsonl
# payloads .jws brutos da API
data/raw/**/*.jws

# Mantidos de propósito (entregáveis / necessários ao app):
